# ========================================
# Digilocker Configuration
# ========================================
# By default, uses MOCK DigiLocker (localhost:3002)
# To switch to real sandbox, update all URLs below

# Mock DigiLocker (default - for local testing)
DIGILOCKER_CLIENT_ID=mock-client-id
DIGILOCKER_CLIENT_SECRET=mock-client-secret
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback
DIGILOCKER_SCOPE=profile documents

# Mock server URLs (running on port 3002)
DIGILOCKER_AUTH_URL=http://localhost:3002/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=http://localhost:3002/public/oauth2/1/token
DIGILOCKER_USER_INFO_URL=http://localhost:3002/public/oauth2/1/user_info
DIGILOCKER_FILES_URL=http://localhost:3002/public/oauth2/1/files
DIGILOCKER_DOWNLOAD_URL=http://localhost:3002/public/oauth2/1/files/download

# ========================================
# Real DigiLocker Sandbox (uncomment when ready)
# ========================================
# Get credentials from: https://sandbox.digilocker.gov.in/
# DIGILOCKER_CLIENT_ID=your_real_sandbox_client_id
# DIGILOCKER_CLIENT_SECRET=your_real_sandbox_client_secret
# DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback
# DIGILOCKER_SCOPE=profile documents
