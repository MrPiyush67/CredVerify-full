# DIGILOCKER_USER_INFO_URL=https://sandbox.digilocker.gov.in/public/oauth2/1/user_info
# DIGILOCKER_FILES_URL=https://sandbox.digilocker.gov.in/public/oauth2/1/files
# DIGILOCKER_DOWNLOAD_URL=https://sandbox.digilocker.gov.in/public/oauth2/1/files/download
